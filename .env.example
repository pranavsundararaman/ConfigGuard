# Copy to .env and replace placeholders locally. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=configguard

# GitHub OAuth App (local callback URL must match the app configuration)
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Generate a unique random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIGGUARD_SESSION_SECRET=<generate-a-long-random-value>
APP_ENV=development

# Machine-to-machine report ingestion only. The dashboard uses GitHub sessions.
CONFIGGUARD_CI_TOKEN=<separate-random-ingest-token>
